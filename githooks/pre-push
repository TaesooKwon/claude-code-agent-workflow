#!/usr/bin/env bash
# githooks/pre-push — 킷·공개 레포의 push 시점 검사(시크릿·실명·이진). push 로 나가는 커밋을 하나씩 부모 대비로 본다.
#   설치 = 각 클론에서 실명 목록 파일(600) 먼저 → `git config core.hooksPath <원본 체크아웃 절대경로>/githooks`.
#   커밋별 검사: ①시크릿 = 공유 가드(global/agent-scaffold/claude/hooks/secret-commit-guard.sh)를 층 A 합성 입력으로 —
#     가드 판은 원격 판(이미 공개된 판)과 로컬 판(push 하는 끝 커밋의 판)을 둘 다 돌려 하나라도 deny/ask 면 차단
#     ②이진 = numstat `-	-` 인 경로가 확장자 허용 목록 밖이면 차단 ③실명 = SCRUB_NAMES_FILE 목록이 추가 줄(이진은 원시 바이트)·경로·커밋 메시지·태그 메시지에 있으면 차단.
#   실패·판정 불가 = 차단(exit 1). 검사가 찾은 값(시크릿·실명)은 출력하지 않는다 — ref·경로·원격 표시는 실명이 들면 자리표시로 바꾸고,
#   원격 URL 의 자격 증명·쿼리 문자열은 가린다. 안내 명령에 넣는 ref·원격 이름은 셸 인용(작은따옴표 — UTF-8 그대로 · 제어 문자가 들면 printf %q)하거나 자리표시로 낸다.
# 위협 모델 = 사고 방지. 범위 밖:
# ponytail: `git push --no-verify`·hooksPath 해제·이 훅 편집 같은 고의 우회는 막지 않는다 / 업그레이드 = 원격 쪽 검사(서버 훅·CI)
# ponytail: 에이전트 push 관문(CLAUDECODE=1 이면 env ALLOW_GIT_PUSH=1 일 때만 진행)은 에이전트가 그 토큰을 스스로 붙여도 열린다 —
#   "사용자가 이번 push 를 지시했다"는 확인은 규약 수준이다 / 업그레이드 = 사람만 아는 일회성 토큰
# ponytail: `gh api` 콘텐츠 업로드처럼 git 전송이 아닌 반출은 이 훅이 보지 않는다 / 업그레이드 = 반출 도구별 가드
# ponytail: 작성자·커미터·tagger 이름/이메일, 브랜치·태그 이름은 검사하지 않는다 / 업그레이드 = `git log --format=%an%n%ae%n%cn%n%ce` 를 실명 대상에 추가
# ponytail: 이 훅 자체는 hooksPath 의 작업 사본 판이 돈다(가드·lib 만 원격 판으로 고정) / 업그레이드 = 훅 본문도 원격 판과 대조
# ponytail: 원격 추적 ref 가 없는 push(새 원격·URL push·orphan 새 브랜치)는 기준 가드 판이 없어 차단한다 /
#   업그레이드 = 이미 공개된 기준선 sha 를 추적 파일로 두고 `--not` 으로 범위에서 뺀다
# ponytail: remote sha 가 있는 ref 는 `remote..local` 전체를 본다 — 다른 원격 ref 에 이미 있는 옛 커밋도 다시 검사해 오탐 차단할 수 있다 /
#   업그레이드 = `--not --remotes=<원격>` 을 함께 준다(로컬 추적 ref 를 믿게 되는 대가)
# ponytail: 가드가 조용히 무기능이 되는 판(빈 출력 rc 0)은 사전 점검(bash -n·함수 존재)만으로 가린다 /
#   업그레이드 = push 마다 더미 토큰 카나리를 같은 경로로 돌려 deny 가 아니면 차단
# ponytail: 이진 허용 목록(BIN_ALLOW_RE) = 이미지·폰트 확장자. 판정이 확장자라 내부 압축 데이터·확장자 위장은 못 보고, 그 내용은
#   시크릿 가드가 보지 않는다(실명만 원시 바이트로 훑는다). 범용 아카이브·문서 형식(zip·jar·xlsx·pdf 등)은 허용 목록에 두지 않는다 /
#   업그레이드 = 확장자 대신 매직 바이트 대조
# ponytail: 태그 서명 블록(마지막 서명 표지 줄부터 끝 — SIG_AWK)은 실명 검사에서 뺀다 — 그 안에 쓴 글은 못 본다 /
#   업그레이드 = 서명 블록에서 armor 본문(base64) 줄만 빼고 나머지 줄은 검사
set -u
# 링크 worktree 에서 git 이 훅에 넘기는 저장소 환경을 지운다 — 남기면 아래 `git -C <임시 worktree>` 가 push 하는
# 사용자 worktree 의 HEAD·인덱스를 바꾼다. 지운 뒤에는 cwd(git 이 훅을 도는 작업 트리 최상위)로 저장소를 다시 찾는다.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
# 뒤에 덧붙일 경로(기본 = Homebrew 설치 경로). PRE_PUSH_EXTRA_PATH 로 바꾸고, 빈 값이면 덧붙이지 않는다.
EXTRA_PATH=${PRE_PUSH_EXTRA_PATH-/opt/homebrew/bin:/usr/local/bin}
[ -n "$EXTRA_PATH" ] && PATH="$PATH:$EXTRA_PATH"
export LC_ALL=C

REMOTE="${1:-}"
GUARD_REL='global/agent-scaffold/claude/hooks/secret-commit-guard.sh'
LIB_REL='global/agent-scaffold/claude/hooks/lib/git-cmd.sh'
BIN_ALLOW_RE='\.(png|jpg|jpeg|gif|ico|woff|woff2)$'
SCRUB_NAMES_FILE="${SCRUB_NAMES_FILE:-$HOME/.claude/scrub-names.txt}"
HDR='[pre-push 검사]'

die() {  # 한 덩어리 안내 후 exit 1 — $1 = 원인, $2 = 조치(없으면 생략)
  { printf '%s push 를 막았습니다 — %s\n' "$HDR" "$1"; [ -n "${2:-}" ] && printf '  조치: %s\n' "$2"; } >&2
  exit 1
}
show() { printf '"%s"' "$(printf '%s' "$1" | tr -d '\000-\037\177')"; }   # ref·경로 표시 — 제어 문자를 빼고 따옴표로 감싼다

# 에이전트 push 관문 — 에이전트 실행(CLAUDECODE=1)이면 실제 env ALLOW_GIT_PUSH=1 일 때만 아래 검사로 간다(둘 다 정확히 "1" 비교).
#   사용자 터미널(CLAUDECODE 미설정)은 이 관문을 지나 그대로 검사한다.
[ "${CLAUDECODE:-}" = 1 ] && [ "${ALLOW_GIT_PUSH:-}" != 1 ] && die "에이전트 실행(CLAUDECODE=1)의 push 는 사용자 전담입니다 — 에이전트는 커밋 해시까지만 보고하세요." \
  "사용자가 이번 push 를 명시적으로 지시한 경우에만 ALLOW_GIT_PUSH=1 을 명령 앞에 붙여 다시 실행하세요."

command -v jq >/dev/null 2>&1 || die "jq 가 없어 가드 판정을 읽을 수 없습니다." "jq 설치(brew install jq) 후 다시 push 하세요."
command -v git >/dev/null 2>&1 || die "git 을 찾을 수 없습니다."
git rev-parse --git-dir >/dev/null 2>&1 || die "저장소를 찾을 수 없습니다(훅 cwd)."

TMP=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX") || die "임시 디렉터리를 만들 수 없습니다."
WT="$TMP/wt"; IDX="$TMP/index"; WT_MADE=0
cleanup() {
  [ "$WT_MADE" = 1 ] && git worktree remove --force "$WT" >/dev/null 2>&1
  case "$TMP" in "${TMPDIR:-/tmp}"/pre-push.*) rm -rf "$TMP" ;; esac
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# stdin 을 먼저 다 읽는다 — 아래 git·가드 호출이 남은 줄을 먹지 않게.
SHA_RE='^[0-9a-f]{40}([0-9a-f]{24})?$'
ZERO_RE='^0+$'
n=0
while IFS= read -r line || [ -n "$line" ]; do
  [ -n "$line" ] || continue
  set -f; set -- $line; set +f
  [ "$#" -eq 4 ] || die "push 입력 줄 형식이 낯섭니다(필드 $#개)." "git 판·push 방식을 확인하세요."
  [[ $2 =~ $SHA_RE ]] && [[ $4 =~ $SHA_RE ]] || die "push 입력의 sha 형식이 낯섭니다."
  L_REF[$n]=$1; L_SHA[$n]=$2; R_REF[$n]=$3; R_SHA[$n]=$4; n=$((n+1))
done
[ "$n" -gt 0 ] || exit 0

# 실명 목록 정제 — BOM·CR 제거, 앞뒤 공백 trim, 빈 줄 제거. 경로에 무엇이 있는데 읽지 못하거나, 가장 가까운 존재 조상
#   디렉터리를 탐색할 수 없어 유무를 가리지 못하면 차단(없음으로 치지 않는다).
dir_blocked() {  # $1 = 경로 → 가장 가까운 존재 조상이 탐색(x) 불가 디렉터리면 rc 0. 짝 = doctor.sh [5f] 의 같은 이름 함수
  local d=$1 up
  while up=$(dirname -- "$d") && [ "$up" != "$d" ]; do
    d=$up
    if [ -e "$d" ] || [ -L "$d" ]; then [ -d "$d" ] && [ ! -x "$d" ]; return; fi
  done
  return 1
}
PAT="$TMP/names"; : > "$PAT"
if [ -e "$SCRUB_NAMES_FILE" ] || [ -L "$SCRUB_NAMES_FILE" ]; then
  bom=$(printf '\357\273\277')
  { [ -f "$SCRUB_NAMES_FILE" ] && sed -e "1s/^$bom//" "$SCRUB_NAMES_FILE" > "$TMP/names.raw" 2>/dev/null; } \
    || die "실명 목록을 읽을 수 없습니다($(show "$SCRUB_NAMES_FILE"))." "읽을 수 있는 일반 파일(권한 600, 한 줄에 하나)인지 확인하세요."
  tr -d '\r' < "$TMP/names.raw" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' > "$PAT" \
    || die "실명 목록을 정제할 수 없습니다($(show "$SCRUB_NAMES_FILE"))."
elif dir_blocked "$SCRUB_NAMES_FILE"; then
  die "실명 목록 경로의 상위 디렉터리를 탐색할 수 없어 목록 유무를 판정할 수 없습니다($(show "$SCRUB_NAMES_FILE"))." \
    "상위 디렉터리의 실행(탐색) 권한과 SCRUB_NAMES_FILE 값을 확인하세요."
fi
NAMES_ON=0; [ -s "$PAT" ] && NAMES_ON=1
has_name() { command grep -aqiF -f "$PAT"; }   # stdin 에 실명이 있으면 rc 0
nm() {  # ref·경로 표시 — $1 에 실명이 들었으면 값 대신 자리표시 $2 를 낸다
  if [ "$NAMES_ON" = 1 ] && printf '%s' "$1" | has_name; then printf '%s' "$2"; else show "$1"; fi
}
sq() {  # 셸 인용 — 작은따옴표로 감싸고 안의 ' 는 '\'' 로(복사 실행 때 확장되지 않고 UTF-8 은 그대로 보인다). 제어 문자가 들면 printf %q(한 줄 유지)
  local r="'\\''"
  case $1 in *[[:cntrl:]]*) printf '%q' "$1" ;; *) printf "'%s'" "${1//\'/$r}" ;; esac
}
nq() {  # 안내 명령에 넣는 값 — $1 에 실명이 들었으면 자리표시 $2, 아니면 sq 인용
  if [ "$NAMES_ON" = 1 ] && printf '%s' "$1" | has_name; then printf '%s' "$2"; else sq "$1"; fi
}
# 원격 표시 — 인자(원격 이름 또는 사용자가 친 URL)에서 자격 증명(scheme://userinfo@)·쿼리 문자열을 가리고 실명이 들면 자리표시.
#   안내 명령에는 가린 데가 없을 때만 인용한 원값을, 아니면 자리표시를 넣는다.
rmask=$(printf '%s' "$REMOTE" | sed -E -e 's#^([A-Za-z][A-Za-z0-9+.-]*://)[^/]*@#\1<자격 증명 생략>@#' -e 's#\?.*#?<생략>#')
rdisp=$(nm "$rmask" '<원격>')
if [ "$rdisp" = "$(show "$REMOTE")" ]; then rcmd=$(sq "$REMOTE"); else rcmd='<원격>'; fi

EMPTY_TREE=$(git hash-object -t tree /dev/null) || die "빈 트리 id 를 계산할 수 없습니다."
prep_guard() {  # $1 = 커밋 → stdout = 가드 디렉터리. 꺼내기·문법·함수 점검 실패 = rc 1
  local c=$1 d="$TMP/guard-$1"
  [ -d "$d" ] && { printf '%s' "$d"; return 0; }   # 이미 꺼낸 판(커밋 sha 단위 디렉터리)은 다시 쓴다
  mkdir -p "$d/lib" || return 1
  git show "$c:$GUARD_REL" > "$d/secret-commit-guard.sh" 2>/dev/null || return 1
  git show "$c:$LIB_REL" > "$d/lib/git-cmd.sh" 2>/dev/null || return 1
  bash -n "$d/secret-commit-guard.sh" 2>/dev/null && bash -n "$d/lib/git-cmd.sh" 2>/dev/null || return 1
  ( . "$d/lib/git-cmd.sh" && type git_has_subcommand ) >/dev/null 2>&1 || return 1
  if command grep -q git_strip_heredoc "$d/secret-commit-guard.sh"; then
    ( . "$d/lib/git-cmd.sh" && type git_strip_heredoc ) >/dev/null 2>&1 || return 1
  fi
  printf '%s' "$d"
}
run_guard() {  # $1 = 가드 디렉터리 → rc 0 = 통과, 1 = 차단(판정 불가 포함). 임시 worktree 의 HEAD·인덱스가 준비된 상태에서 부른다.
  local out rc dec
  out=$(jq -nc --arg c "$WT" '{tool_input:{command:"git commit"},cwd:$c}' \
    | (cd "$WT" && GATE_LAYER=git GIT_INDEX_FILE="$IDX" bash "$1/secret-commit-guard.sh") 2>/dev/null); rc=$?
  [ "$rc" -eq 0 ] || return 1
  [ -n "$(printf '%s' "$out" | tr -d '[:space:]')" ] || return 0
  dec=$(printf '%s' "$out" | jq -rs 'map(.hookSpecificOutput.permissionDecision // "?") | unique | join(",")' 2>/dev/null) || return 1
  case "$dec" in allow) return 0 ;; *) return 1 ;; esac   # judge-line: deny·ask·낯선 값·빈 판정 = 차단
}

FIND=""   # 차단 사유 누적(한 덩어리로 낸다)
add() { FIND="${FIND}
  - ${3:-커밋} ${1:0:12}: $2"; }   # $1 = 객체 sha, $2 = 사유, $3 = 종류(기본 커밋)
RECOVER=""
recover() {  # 이 ref 의 조치를 RECOVER 에 더한다 — $1 = 커밋 범위 지적(1/0). 태그 메시지 지적(tag_bad)과 겹치면 한 줄로 합친다.
  local fixc step lab q tsfx=""
  if [ "$1" = 1 ]; then
    fixc="\`git reset --soft ${base:0:12}\` 로 push 안 된 커밋을 풀고 문제 내용을 고친 뒤 다시 커밋"
    [ "$tag_bad" = 1 ] && tsfx=", 태그 객체도 고친 메시지로 다시 만든다"
    case "$lref" in
      refs/heads/*) lab=$(nm "${lref#refs/heads/}" '<브랜치>'); q=$(nq "${lref#refs/heads/}" '<브랜치>'); step="\`git switch $q\` 후 $fixc$tsfx" ;;
      refs/tags/*) lab=$(nm "${lref#refs/tags/}" '<태그>'); q=$(nq "${lref#refs/tags/}" '<태그>')
        if [ "$tag_bad" = 1 ]; then
          step="태그가 가리키는 커밋을 담은 브랜치로 switch 한 뒤 $fixc, 고친 커밋에 고친 메시지로 다시 태그한다(\`git tag -d $q\` 먼저)"
        else step="태그가 가리키는 커밋을 담은 브랜치로 switch 한 뒤 $fixc, 그 커밋에 태그를 다시 만든다(\`git tag -d $q\` 먼저)"; fi ;;
      *) lab=$(nm "$lref" '<ref>'); step="이 커밋을 담은 브랜치로 switch 한 뒤 $fixc$tsfx" ;;
    esac
  elif [ "$tag_bad" = 1 ]; then
    case "$lref" in
      refs/tags/*) lab="태그 $(nm "${lref#refs/tags/}" '<태그>')"; q=$(nq "${lref#refs/tags/}" '<태그>')
        step="\`git tag -d $q\` 후 고친 메시지로 \`git tag -a $q ${lc:0:12}\` 를 다시 만들어 push" ;;
      *) lab=$(nm "$lref" '<ref>'); step="이 ref 가 가리키는 태그 객체를 고친 메시지로 다시 만들어 push" ;;
    esac
  else return 0
  fi
  RECOVER="${RECOVER}
  - $lab: $step"
}
# 태그 메시지에서 서명 블록(서명 표지로 시작하는 마지막 줄부터 끝)을 뺀다.
#   git 이 서명으로 치는 범위 대조 = `git for-each-ref --format='%(contents:signature)' refs/tags/<태그>`
SIG_AWK='{ l[NR] = $0 } /^-----BEGIN (PGP SIGNATURE|PGP MESSAGE|SIGNED MESSAGE|SSH SIGNATURE)-----/ { m = NR }
  END { if (!m) m = NR + 1; for (i = 1; i < m; i++) print l[i] }'

for ((i = 0; i < n; i++)); do
  lref=${L_REF[$i]}; lsha=${L_SHA[$i]}; rref=${R_REF[$i]}; rsha=${R_SHA[$i]}
  [[ $lsha =~ $ZERO_RE ]] && continue   # 삭제 push — 나가는 내용이 없다
  lc=$(git rev-parse -q --verify "$lsha^{commit}" 2>/dev/null) \
    || die "$(nm "$lref" '<ref>') 이 커밋을 가리키지 않습니다(트리·블롭 태그 또는 없는 객체)." "커밋을 가리키는 ref 만 push 하세요."
  # 태그 객체 = 메시지(헤더 뒤 첫 빈 줄 이후, 서명 블록 앞)만 실명 검사 — 헤더의 태그 이름·tagger 는 위 ponytail 대로 범위 밖.
  #   태그가 태그를 가리키면 안쪽 태그 객체도 함께 나가므로 태그가 아닌 객체에 닿을 때까지 따라가며 각 메시지를 본다.
  tag_bad=0; o=$lsha
  while [ "$NAMES_ON" = 1 ] && [ "$(git cat-file -t "$o" 2>/dev/null)" = tag ]; do
    git cat-file tag "$o" > "$TMP/tag" 2>/dev/null || die "태그 객체 ${o:0:12} 를 읽을 수 없습니다."
    if sed '1,/^$/d' "$TMP/tag" | tr -d '\000' | awk "$SIG_AWK" | has_name; then
      inner=""; [ "$o" = "$lsha" ] || inner=" 의 안쪽 태그"
      add "$o" "태그 메시지에 실명($(nm "$lref" '태그 이름 생략')$inner)" 태그
      tag_bad=1
    fi
    cur=$o; o=$(sed -n '1s/^object //p' "$TMP/tag")
    [[ $o =~ $SHA_RE ]] || die "태그 객체 ${cur:0:12} 의 대상(object 줄)을 읽을 수 없습니다."
  done
  if [[ $rsha =~ $ZERO_RE ]]; then
    refs=$(git for-each-ref --format='%(objectname)' "refs/remotes/$REMOTE/" 2>/dev/null)
    [ -n "$refs" ] || die "원격 $rdisp 의 추적 ref(refs/remotes/<원격>/)가 0개라 기준 가드 판·검사 범위를 정할 수 없습니다." \
      "URL 이면 원격 이름으로, 원격에 브랜치가 있으면 \`git fetch <원격>\` 후 다시 push 하세요. 브랜치가 하나도 없는 원격으로의 첫 push 는 이 훅을 통과하지 못하니 사용자에게 확인하세요."
    # shellcheck disable=SC2086
    base=$(git merge-base "$lc" $refs 2>/dev/null) \
      || die "$(nm "$lref" '<ref>') 이 원격 이력과 공통 조상이 없어(orphan) 기준 가드 판을 정할 수 없습니다." \
        "이미 공개된 브랜치 위로 push 하거나 사용자에게 확인하세요."
    range=$(git rev-list --reverse --topo-order "$lc" --not --remotes="$REMOTE" 2>/dev/null) \
      || die "$(nm "$lref" '<ref>') 의 검사 범위를 계산할 수 없습니다."
  else
    rc_=$(git rev-parse -q --verify "$rsha^{commit}" 2>/dev/null) \
      || die "원격 sha ${rsha:0:12}($(nm "$rref" '<ref>')) 이 로컬에 없습니다." "\`git fetch $rcmd\` 후 다시 push 하세요."
    base=$rc_
    range=$(git rev-list --reverse --topo-order "$lc" --not "$rc_" 2>/dev/null) \
      || die "$(nm "$lref" '<ref>') 의 검사 범위를 계산할 수 없습니다."
  fi
  if [ "$NAMES_ON" = 0 ]; then
    if git cat-file -e "$lc:.public-snapshot" 2>/dev/null || git cat-file -e "$base:.public-snapshot" 2>/dev/null; then
      die "공개 레포(.public-snapshot)인데 실명 목록이 없거나 비었습니다($(show "$SCRUB_NAMES_FILE"))." \
        "실명 목록 파일(권한 600, 한 줄에 하나)을 만든 뒤 다시 push 하세요."
    fi
    printf '%s 경고: 실명 목록이 없거나 비어 실명 검사를 건너뜁니다(%s).\n' "$HDR" "$(show "$SCRUB_NAMES_FILE")" >&2
  fi
  [ -n "$range" ] || { recover 0; continue; }
  g_remote=$(prep_guard "$base") || die "원격 판(${base:0:12})에 $GUARD_REL·lib 가 없거나 문법·함수 점검에 실패했습니다." "사용자에게 확인하세요."
  g_local=$(prep_guard "$lc") || die "로컬 판 가드($(nm "$lref" '<ref>'))를 꺼내거나 점검할 수 없습니다." "$GUARD_REL·lib 가 커밋에 있는지 확인하세요."
  if [ "$WT_MADE" = 0 ]; then
    git worktree add --no-checkout --detach "$WT" "$lc" >/dev/null 2>&1 || die "검사용 임시 worktree 를 만들 수 없습니다."
    WT_MADE=1
  fi
  bad_before=${#FIND}
  for c in $range; do
    p=$(git rev-parse -q --verify "$c^1" 2>/dev/null) || p=""
    if [ -n "$p" ]; then
      git -C "$WT" update-ref --no-deref HEAD "$p" >/dev/null 2>&1 || die "임시 worktree HEAD 를 옮길 수 없습니다(${c:0:12})."
      ptree=$p
    else  # 루트 커밋 — HEAD 를 없는 브랜치(unborn)에 두어 가드가 빈 트리 대비로 본다
      ub="refs/heads/pre-push-unborn-$$-$RANDOM"
      git show-ref --verify --quiet "$ub" && die "임시 브랜치 이름이 이미 있습니다($ub)."
      git -C "$WT" symbolic-ref HEAD "$ub" >/dev/null 2>&1 || die "임시 worktree HEAD 를 unborn 으로 둘 수 없습니다(${c:0:12})."
      ptree=$EMPTY_TREE
    fi
    GIT_INDEX_FILE="$IDX" git -C "$WT" read-tree "$c" >/dev/null 2>&1 || die "커밋 ${c:0:12} 의 트리를 읽을 수 없습니다."
    # ① 시크릿 — 원격 판·로컬 판 둘 다
    run_guard "$g_remote" || add "$c" "시크릿 패턴(원격 판 가드)"
    [ "$g_local" = "$g_remote" ] || run_guard "$g_local" || add "$c" "시크릿 패턴(로컬 판 가드)"
    # ② 이진 — 임시 worktree 문맥(C 의 .gitattributes)으로 numstat
    # 파일로 받는다 — $(…) 는 NUL 을 지운다. 마지막 레코드도 NUL 로 끝난다(-z).
    GIT_INDEX_FILE="$IDX" git -C "$WT" -c core.quotepath=false diff --cached --numstat -z --no-renames --diff-filter=ACMRT \
      > "$TMP/numstat" 2>/dev/null || die "커밋 ${c:0:12} 의 이진 판정을 할 수 없습니다."
    while IFS= read -r -d '' rec; do
      case "$rec" in
        "-	-	"*) f=${rec#-	-	}
          printf '%s' "$f" | command grep -Eqi "$BIN_ALLOW_RE" && continue
          if [ "$NAMES_ON" = 1 ] && printf '%s' "$f" | has_name; then add "$c" "허용 목록 밖 이진 파일(경로에 실명 — 이름 생략)"
          else add "$c" "허용 목록 밖 이진 파일 $(show "$f")"; fi ;;
      esac
    done < "$TMP/numstat"
    # ③ 실명 — 추가 줄(헤더는 hunk 상태로 제외)·경로·메시지. NUL 은 awk 앞에서 지운다(awk 판에 따라 NUL 뒤를 버린다).
    if [ "$NAMES_ON" = 1 ]; then
      added() { git diff --text -U0 --no-color --no-ext-diff --no-textconv "$ptree" "$c" "$@" 2>/dev/null | tr -d '\000' \
        | awk '/^diff --git /{h=0; next} /^@@ /{h=1; next} h && /^\+/{print substr($0, 2)}'; }
      if added | has_name; then
        while IFS= read -r -d '' f; do
          GIT_LITERAL_PATHSPECS=1 added -- "$f" | has_name || continue
          if printf '%s' "$f" | has_name; then add "$c" "추가 줄에 실명(경로에도 실명 — 이름 생략)"
          else add "$c" "추가 줄에 실명 $(show "$f")"; fi
        done < <(git -c core.quotepath=false diff --name-only -z --diff-filter=ACMRT "$ptree" "$c" 2>/dev/null)
      fi
      git -c core.quotepath=false diff --name-only -z --diff-filter=ACMRT "$ptree" "$c" 2>/dev/null | tr '\0' '\n' | has_name \
        && add "$c" "경로에 실명"
      git log -1 --format=%B "$c" 2>/dev/null | has_name && add "$c" "커밋 메시지에 실명"
    fi
  done
  if [ "${#FIND}" -gt "$bad_before" ]; then recover 1; else recover 0; fi
done

[ -z "$FIND" ] && exit 0
{
  printf '%s push 를 막았습니다 — 나가는 커밋에 공개하면 안 되는 내용이 있습니다(값은 출력하지 않음):%s\n' "$HDR" "$FIND"
  printf '  조치:%s\n' "$RECOVER"
  printf '  확인: git show <커밋> 으로 위치를 보고, 오탐이면 사용자에게 확인하세요.\n'
} >&2
exit 1
