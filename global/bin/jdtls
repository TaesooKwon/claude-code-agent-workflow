#!/bin/sh
# jdtls 래퍼 심 — jdtls(Eclipse JDT.LS)는 Java 21+ 필요.
# 셸 기본 JAVA_HOME이 구버전(프로젝트 빌드용 Java 8 등)이면 "requires at least Java 21"로 즉사 →
# 이 프로세스에서만 21+로 지정해 실행(빌드 환경엔 영향 없음).
# 설치 위치: ~/.local/bin/jdtls (bootstrap-machine.sh가 설치, PATH에서 brew보다 앞이어야 함).
if [ -x /usr/libexec/java_home ]; then
    JH="$(/usr/libexec/java_home -v 21 2>/dev/null || true)"
    [ -n "$JH" ] && export JAVA_HOME="$JH"
fi

# 실제 jdtls 바이너리(brew) — 이 심이 PATH 앞이라 command -v 는 자기 자신을 잡음 → 명시 경로 순회.
REAL=""
for c in /opt/homebrew/bin/jdtls /usr/local/bin/jdtls; do
    [ -x "$c" ] && REAL="$c" && break
done
[ -n "$REAL" ] || { echo "jdtls 바이너리 없음 — brew install jdtls" >&2; exit 127; }

# Lombok 애노테이션 처리 — javaagent 없으면 @Getter/@Builder/@RequiredArgsConstructor 바인딩이 깨져
# findReferences/callHierarchy가 호출처를 놓친다(진단 노이즈도 대량). 로컬 maven 레포에서
# 최신판 자동 탐색(오프라인 레포 우선, 없으면 ~/.m2), 있을 때만 주입.
# 루트별로 따로 정렬 — 두 루트를 한 sort에 섞으면 경로 접두로 정렬돼 버전 비교가 깨진다.
LOMBOK_JAR=""
for root in "__MAVEN_REPO__" "$HOME/.m2/repository"; do
    LOMBOK_JAR="$(ls "$root"/org/projectlombok/lombok/*/lombok-*.jar 2>/dev/null | grep -Ev '(sources|javadoc)' | sort -V | tail -1)"
    [ -n "$LOMBOK_JAR" ] && break
done
if [ -n "$LOMBOK_JAR" ] && [ -f "$LOMBOK_JAR" ]; then
    exec "$REAL" --jvm-arg=-javaagent:"$LOMBOK_JAR" "$@"
fi
exec "$REAL" "$@"
