/**
 * <<KOR>> 목록 화면 스크립트 (BO)
 * 전역 의존: CTX_ROOT, CODE, {{JS_NS}}(requestFetch/paging/alert/getRecordNumObj/isEmpty), cms_csrf, modal, toast, agGrid — cmsSubLayout이 로드
 */
(function() {

    const gridOptions = {
        colResizeDefault: "shift",
        defaultColDef: {
            flex: 1,
            resizable: true,
        },
        columnDefs: [
            <<BLOCK:GRID_COLUMNS>>
            {
                headerName: '수정',
                field: '<<pkField>>',
                headerClass: 'center',
                cellClass: 'center',
                width: 100,
                flex: 0,
                cellRenderer: (param) => {
                    if ({{JS_NS}}.isEmpty(param.value)) return '';
                    return `<button type='button' class='btn sm secondary btn-mdfcn-<<domain>>' data-src="${CTX_ROOT}/<<module>>/<<pkg>>/modify<<Domain>>.do?<<pkField>>=${encodeURIComponent(param.value)}" title="수정"><i class="ico-pencil-simple-line"></i>수정</button>`;
                }
            },
        ],
        // 신버전(v2+) 체크박스 방식 — columnDefs에 체크박스 컬럼 선언 금지
        rowSelection: {
            mode: 'multiRow',
            checkboxes: true,
            headerCheckbox: true,
            enableClickSelection: false,
        }
    };

    const gridEl = document.querySelector('#grid');
    const gridApi = agGrid.createGrid(gridEl, gridOptions);
    const pagingEl = document.querySelector('#paging');

    const getDataList = function(page = 1) {
        const formEl = document.querySelector('.search-form');
        const actionUrl = formEl.getAttribute('action');

        formEl.querySelector('[name="pageIndex"]').value = page;
        const formData = new FormData(formEl);

        {{JS_NS}}.requestFetch(actionUrl, {
            method: 'get',
            body: formData,
        }, (resp) => {
            if (resp.resultCode === CODE.RCV_SUCCESS) {
                const recordNumObj = {{JS_NS}}.getRecordNumObj(resp.result.paginationInfo);
                resp.result.resultList.forEach(function (item, index) {
                    item.rowNum = (recordNumObj.currentPageNo - 1) * recordNumObj.pageSize + index + 1;
                });
                gridApi.setGridOption('rowData', resp.result.resultList);

                const pagInfo = resp.result.paginationInfo;
                const totalCountEl = document.getElementById('totalCount');
                if (totalCountEl && pagInfo) totalCountEl.textContent = pagInfo.totalRecordCount;

                // 페이징은 팀 표준 {{JS_NS}}.paging (ag-Grid 내장 pagination 금지)
                {{JS_NS}}.paging(pagingEl, resp.result.paginationInfo, (pageIndex) => {
                    getDataList(pageIndex);
                });
            }
        }, (err) => {
            console.error(err);
        });
    };

    document.addEventListener('DOMContentLoaded', () => {
        getDataList();
    });

    document.addEventListener('submit', (e) => {
        if (e.target.closest('.search-form')) {
            e.preventDefault();
            getDataList();
        }
    });

    document.addEventListener('click', (e) => {
        if (e.target.closest('.btn-mdfcn-<<domain>>')) { // 수정 이동
            e.preventDefault();
            location.href = e.target.closest('.btn-mdfcn-<<domain>>').dataset.src;
        }

        if (e.target.closest('.btn-delete-<<domain>>')) { // 선택삭제 → 모달
            e.preventDefault();
            const selectedRows = gridApi.getSelectedRows();
            if (selectedRows.length === 0) {
                toast.show('삭제할 <<KOR>>을(를) 선택하세요.');
                return;
            }
            window.modal.open('modal-del-confirm');
        }

        if (e.target.closest('[data-modal="modal-del-confirm"] .btn-confirm-delete')) { // 모달 확정 → DELETE 요청
            e.preventDefault();
            const selectedRows = gridApi.getSelectedRows();
            if (selectedRows.length === 0) return;

            const params = new URLSearchParams();
            selectedRows.forEach(row => params.append('<<pkField>>s', row.<<pkField>>));
            const formData = new FormData();
            formData.append('_csrf', cms_csrf.token);

            window.modal.close('modal-del-confirm');
            {{JS_NS}}.requestFetch(`${CTX_ROOT}/<<module>>/<<pkg>>/delete<<Domain>>.json?${params.toString()}`, {
                method: CODE.DELETE,
                body: formData,
            }, (resp) => {
                if (resp.resultCode === CODE.RCV_SUCCESS) {
                    {{JS_NS}}.alert('정상적으로 삭제되었습니다.', () => getDataList(1));
                } else {
                    {{JS_NS}}.alert('삭제 중 오류가 발생했습니다.');
                }
            }, () => {{JS_NS}}.alert('삭제 중 오류가 발생했습니다.'));
        }
    });

    document.addEventListener('change', (e) => {
        if (e.target.closest('.search-form select')) {
            getDataList();
        }
    });
})();
