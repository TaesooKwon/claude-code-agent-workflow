<!DOCTYPE html>
<html lang="ko"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{comn/site/layout/cmsSubLayout}">
<head>
    <meta charset="UTF-8">
    <title><<KOR>> 관리</title>
</head>
<body>
<th:block layout:fragment="content">
    <div class="content">
        <header class="page-header">
            <div class="page-header__content">
                <h2 class="page-header__tit" th:text="${title}"><<KOR>> 관리</h2>
            </div>
        </header>

        <div class="pannel">
            <form name="searchForm" class="search-form" method="get" th:action="@{/<<module>>/<<pkg>>/read<<Domain>>List.json}">
                <input type="hidden" name="pageIndex" value="1">
                <section class="section">
                    <h3 class="sr-only"><<KOR>> 목록</h3>
                    <div class="section__body">
                        <div class="actions-extend">
                            <div class="actions-extend__default">
                                <div class="actions-extend__default-area actions-extend__default-area--left">
                                    <p class="total">총 <em id="totalCount">0</em>건</p>
                                    <button type="button" class="btn sm btn-delete-<<domain>>">선택 삭제</button>
                                </div>
                                <div class="actions-extend__default-area actions-extend__default-area--right">
                                    <fieldset class="schbox">
                                        <legend>검색</legend>
                                        <<BLOCK:SEARCH_OPTIONS>>
                                        <button type="submit" class="schbox__btn"><span class="sr-only">검색</span></button>
                                    </fieldset>
                                    <a th:href="@{/<<module>>/<<pkg>>/create<<Domain>>.do}" class="btn primary ico-write">
                                        <i aria-hidden="true" class="ico-pencil-simple"></i>등록
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- TODO(디자인): 그리드 높이·컬럼 폭 등 화면 확정 -->
                        <div id="grid" class="tbl-ag" style="height: 450px;"></div>
                        <div id="paging"></div>
                    </div>
                </section>
            </form>
        </div>
    </div>

    <!-- 삭제 확인 모달 -->
    <dialog class="modal sm" data-modal="modal-del-confirm">
        <div class="modal__header">
            <div class="modal__header-area modal__header-area--center">
                <h1 class="modal__title">삭제하기</h1>
            </div>
        </div>
        <div class="modal__body">
            <p class="modal__text" style="text-align: center;">
                삭제 버튼을 선택하시면 삭제 처리가 됩니다.<br/>
                삭제된 내용은 복원이 불가합니다.
            </p>
        </div>
        <div class="modal__footer">
            <div class="modal__footer-area modal__footer-area--center">
                <div class="btn-group">
                    <button type="button" class="btn primary btn-confirm-delete">삭제</button>
                    <button type="button" class="btn" onclick="modal.close('modal-del-confirm')">취소</button>
                </div>
            </div>
        </div>
        <button type="button" class="modal__close-btn" onclick="modal.close('modal-del-confirm')">
            <i class="ico-x"></i><span class="sr-only">닫기</span>
        </button>
    </dialog>
</th:block>

<th:block layout:fragment="script">
    <script th:src="@{/resources/js/cms/<<module>>/<<pkg>>/<<domain>>Index.js}"></script>
</th:block>
</body>
</html>
