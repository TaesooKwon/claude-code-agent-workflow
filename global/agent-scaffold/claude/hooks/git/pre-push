#!/usr/bin/env bash
# git pre-push(층 A) — 에이전트(CLAUDECODE=1)의 원격 반영을 git 실행 시점에서 막는다. PreToolUse 의 전역
# git-push-guard.sh 는 명령 문자열 판정(조기 피드백)이고, 이 훅은 어떤 형태로 호출했든(래퍼·eval·별칭) 실제 push 에서 돈다.
# 우회 = 실제 환경변수 ALLOW_GIT_PUSH=1(사용자가 이번 푸시를 명시 지시한 경우만). 사용자 터미널(CLAUDECODE 미설정)은 무영향.
# ponytail: `--no-verify` 는 이 훅을 건너뛴다 — PreToolUse git-hook-bypass-guard.sh 가 그 낱말을 막는다 / 원격 보호 브랜치가 최종 방어.
[ "${CLAUDECODE:-}" = 1 ] || exit 0
[ "${ALLOW_GIT_PUSH:-}" = 1 ] && exit 0
printf '%s\n' "[git 훅 층 A — pre-push] 푸시는 사용자 전담입니다 — 에이전트는 커밋 해시까지만 보고하세요.
사용자가 이번 푸시를 명시적으로 지시한 경우에만 ALLOW_GIT_PUSH=1 을 명령 앞에 붙여 다시 실행하세요." >&2
exit 1
# ↓ 본문 끝 표지 — 반드시 마지막 줄로 둔다(install-git-hooks.sh 가 빈 파일·잘린 본문을 이 줄 유무로 가린다).
