#!/usr/bin/env bash
# git pre-commit 디스패처(층 A — 커밋 내용 게이트의 권위 층). `.git/hooks/pre-commit` 스텁이 이 파일을 exec 한다
# (설치 = bash .claude/scripts/install-git-hooks.sh). pre-merge-commit 은 `--merge` 인자를 붙여 이 파일을 exec 한다.
#
# 왜 git 훅인가: PreToolUse(Bash) 는 명령 문자열과 "그 시점 인덱스"만 본다 → pathspec 커밋(`git commit -m m a.txt`)·
#   `git add x && git commit` 한 호출·`-o`/`-i`·GIT_INDEX_FILE 대입은 실제로 커밋될 내용을 못 본다. pre-commit 안의
#   `git diff --cached` 는 git 이 넘긴 GIT_INDEX_FILE 을 상속해 **실제 커밋될 트리**를 본다.
#   ALLOW_* 우회도 여기선 명령 문자열이 아니라 실제 환경변수다(메시지·따옴표 안 문구로 위조 불가).
#
# 동작: 커밋 게이트 스크립트(.claude/hooks/<게이트>.sh — 아래 GATES)를 **수정 없이 재사용**한다. 게이트마다
#   합성 PreToolUse stdin(command = [그 게이트가 아는 ALLOW 중 env 값이 1 인 것의 `VAR=1 ; `] + `git commit`)을 넣고,
#   출력(JSON 문서 하나 이상)에 permissionDecision deny/ask 가 하나라도 있으면 reason 을 stderr 로 내고 exit 1.
#   ALLOW 접두는 대입마다 `; ` 로 끊는다 — 게이트의 우회 정규식은 줄 머리·`;&|` 뒤의 대입만 인정한다.
#
# 병합 모드(`--merge`, git merge 가 스스로 만드는 병합 커밋): 내용 게이트(secret·sql-staging)만 돈다.
#   병합 커밋의 diff 는 들어오는 쪽 변경 전체라 mvn·code-review 마커·test-count 는 에이전트가 미리 충족할 수 없다.
#   git merge 는 인덱스가 HEAD 와 다르면 병합을 거부하므로 이 모드의 내용 = 병합 결과뿐이다(에이전트 추가분이 섞이지 않는다).
# ponytail: 충돌 해소 뒤 `git commit` 으로 병합을 마무리하면 git 은 pre-commit 을 부른다 → 전체 게이트(들어오는 diff 포함)가
#   돈다 — 막히면 안내문의 `git merge --abort` 로 되돌린다 / 업그레이드 = MERGE_HEAD 기준 diff 로 에이전트 해소분만 게이트.
#
# fail 모드 = 디스패처가 직접 보는 조건(도구·파일 부재·게이트 rc·출력 형식)에 한해 판정 불가면 막는다(exit 1):
#   필수 도구·lib·게이트 부재, 게이트 비정상 종료, 출력이 JSON 객체가 아님, permissionDecision 이 알 수 없는 값.
#   게이트가 rc 0 에 빈 출력(또는 allow)을 내면 디스패처는 통과로 받는다 — 게이트 안의 판정 불가를 따로 가려내지 않는다.
#   층 A 를 끄는 정상 경로는 사용자 터미널(CLAUDECODE 미설정)이다 — 에이전트 Bash 에는 CLAUDECODE=1 이 있다.
#   커밋이 거부될 뿐 인덱스·워킹트리는 그대로다(git 이 pre-commit 실패 시 아무것도 쓰지 않는다).
# ponytail: ! 셸 모드 커밋도 CLAUDECODE 상속 시 대상 / 업그레이드 = 사용자 경로 표지 env
# ponytail: cherry-pick·revert·rebase --continue·am 과 저수준 커밋 생성 명령(commit-tree 계열)이 만드는 커밋은 pre-commit 을 거치지 않는다(git 동작 지식 — 이 레포에서 미실측)
#   → 이 경로엔 커밋 게이트가 없다 / 업그레이드 = reference-transaction 훅(CLAUDECODE=1 이고 GIT_REFLOG_ACTION 이 그 계열이면 거부)
#   또는 PreToolUse 층에서 그 하위 명령에 ask.
# ponytail: CLAUDECODE 를 물려받지 않는 실행 경로로 친 커밋, 층 A 밖에서 만든 커밋을 fast-forward 로 들여오는 경우도 이 층을 거치지 않는다
#   / 업그레이드 = 사용자 경로 표지 env 로 판정 반전(에이전트 기본 대상) + reference-transaction 훅.
# ponytail: 병합 모드의 sql 게이트는 upstream 이 추가한 .sql 에도 반응한다(차단 시 merge --abort 안내) / 업그레이드 = MERGE_HEAD 쪽 변경 제외.
# ponytail: 이 층은 스텁이 설치된 레포의 커밋만 본다 — 층 A 가 설치된 프로젝트 세션에서 층 A 미설치 다른 레포에 커밋하면 커밋 게이트가 없다
#   (git-hooks-installed-guard 는 이 프로젝트의 설치만 확인) / 업그레이드 = 커밋 대상 레포의 --check 확인 후 ask.
# ponytail: 게이트 호출에 시간 상한이 없다 — 게이트가 멈추면 커밋도 멈춘다 / 업그레이드 = 게이트별 timeout 래퍼.
# ponytail: 게이트 경로를 env 로 바꾸는 문은 두지 않는다(우회 벡터) — 테스트는 .claude 를 미러링한 임시 레포에서 돈다.
# ponytail: 이 층 앞의 PreToolUse 문자열 가드(git-hook-bypass-guard·git-hooks-installed-guard)는 따옴표 분할·변수 조립·별칭·환경 조작 형태를 모두 보지는 못한다 — 커밋 내용 판정은 이 층이 권위 / 업그레이드 = 정규화 판정·reference-transaction 훅.
# ponytail: worktree 커밋은 CLAUDE_PROJECT_DIR=메인 트리라 mvn-test-result-gate 가 자기 스코프 가드(toplevel 비교)로
#   통과한다(code-review-marker 는 common dir 로 같은 레포를 판정해 그 작업트리 마커로 검문, secret·sql-staging·test-count 는
#   cwd=worktree 기준으로 돈다) / 업그레이드 = mvn 게이트도 common dir 판정 + worktree 별 기록 위치.

[ "${CLAUDECODE:-}" = 1 ] || exit 0

_mode=commit; _hook=pre-commit
case "${1:-}" in
  --merge) _mode=merge; _hook=pre-merge-commit ;;
esac

_recover() { # 거부 뒤 상태 안내(병합이 진행 중이면 되돌리는 길을 함께 낸다)
  if [ "$_mode" = merge ] || git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    printf '병합 진행 중(MERGE_HEAD 남음): 병합을 되돌리려면 `git merge --abort`, 원인을 해소해 이어가려면 `git commit`(이때는 커밋 게이트 전체가 돈다). 병합 전 미커밋 변경이 있었다면 --abort 전에 `git status` 로 먼저 확인하세요.\n' >&2
  fi
}
_die() {
  printf '[git 훅 층 A — %s] 판정 불가로 커밋을 막습니다: %s\n' "$_hook" "$1" >&2
  printf '복구: 원인을 해소하거나 `bash .claude/scripts/install-git-hooks.sh` 로 훅을 재설치하세요. 커밋은 일어나지 않았고 인덱스는 그대로입니다.\n' >&2
  _recover
  exit 1
}

for _t in jq git shasum python3; do
  command -v "$_t" >/dev/null 2>&1 || _die "필수 도구 부재: $_t"
done

_common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || _die "git common dir 을 알 수 없음"
[ -n "$_common" ] || _die "git common dir 이 비어 있음"
MAIN_TOP=$(cd "$_common/.." 2>/dev/null && pwd -P) || _die "메인 작업트리 경로 판정 실패($_common/..)"
TOP=$(git rev-parse --show-toplevel 2>/dev/null) || _die "작업트리 최상위 판정 실패"
[ -n "$TOP" ] || _die "작업트리 최상위가 비어 있음"
HOOKS="$MAIN_TOP/.claude/hooks"

if [ "$_mode" = merge ]; then
  GATES="secret-commit-guard sql-staging-guard"
else
  GATES="secret-commit-guard sql-staging-guard test-count-guard mvn-test-result-gate code-review-marker-reminder"
fi

[ -f "$HOOKS/lib/git-cmd.sh" ] || _die "lib 부재: $HOOKS/lib/git-cmd.sh"
[ -f "$HOOKS/lib/review-diff.sh" ] || _die "lib 부재: $HOOKS/lib/review-diff.sh"
for _g in $GATES; do
  [ -f "$HOOKS/$_g.sh" ] || _die "게이트 부재: $HOOKS/$_g.sh"
done

# 게이트 stderr 는 임시 파일로 받아 비정상 종료 때만 진단 단서로 붙인다.
_errf=$(mktemp "${TMPDIR:-/tmp}/layer-a-gate-err.XXXXXX" 2>/dev/null) || _die "임시 파일 생성 실패(게이트 stderr)"
trap 'rm -f "$_errf"' EXIT

_blocked=0
for _g in $GATES; do
  _gate="$HOOKS/$_g.sh"
  # 그 게이트가 아는 ALLOW 변수(파일 안 낱말 모집단) 중 실제 env 값이 1 인 것만 대입 접두로 싣는다.
  _prefix=""
  for _v in $(grep -ohE 'ALLOW_[A-Z_]+' "$_gate" | sort -u); do
    [ "$(printenv "$_v" 2>/dev/null)" = 1 ] && _prefix="${_prefix}${_v}=1 ; "
  done
  _json=$(jq -cn --arg c "${_prefix}git commit" --arg d "$TOP" \
    '{tool_name:"Bash",hook_event_name:"PreToolUse",tool_input:{command:$c},cwd:$d}') || _die "합성 입력 생성 실패($_g)"
  _out=$(printf '%s' "$_json" | env CLAUDE_PROJECT_DIR="$MAIN_TOP" GATE_LAYER=git bash "$_gate" 2>"$_errf")
  _rc=$?
  if [ "$_rc" -ne 0 ]; then
    # 시크릿 게이트의 stderr 는 diff 내용을 담을 수 있어 싣지 않는다(이름·rc 만).
    if [ "$_g" = secret-commit-guard ]; then
      _die "게이트 비정상 종료($_g rc=$_rc)"
    fi
    _tail=$(tail -n 3 "$_errf" 2>/dev/null | LC_ALL=C tr -d '\000-\010\013-\037\177' | cut -c1-300)
    _die "게이트 비정상 종료($_g rc=$_rc)${_tail:+ — stderr 끝:
$_tail}"
  fi
  # 공백뿐인 출력 = 통과. 그 밖엔 JSON 객체(하나 이상)여야 한다 — 형식이 어긋나면 판정 불가.
  if printf '%s' "$_out" | grep -q '[^[:space:]]'; then
    _dec=$(printf '%s' "$_out" | jq -rs '
      if length > 0 and all(.[]; type == "object") then
        [.[] | .hookSpecificOutput.permissionDecision? // empty] as $d
        | if any($d[]; . == "deny" or . == "ask") then "block"
          elif all($d[]; . == "allow") then "pass"
          else "bad" end
      else "bad" end' 2>/dev/null) || _die "게이트 출력 JSON 파싱 실패($_g)"
    case "$_dec" in
      block)
        printf '%s\n\n' "$(printf '%s' "$_out" | jq -rs '.[] | select(.hookSpecificOutput.permissionDecision? == "deny" or .hookSpecificOutput.permissionDecision? == "ask")
          | .hookSpecificOutput.permissionDecisionReason // "(사유 없음)"' 2>/dev/null)" >&2
        _blocked=1 ;;
      pass) ;;
      *) _die "게이트 출력 형식 판정 불가($_g — JSON 객체가 아니거나 permissionDecision 값이 낯섦)" ;;
    esac
  fi
done

if [ "$_blocked" -ne 0 ]; then
  _recover
  exit 1
fi
exit 0
# ↓ 본문 끝 표지 — 반드시 마지막 줄로 둔다(install-git-hooks.sh 가 빈 파일·잘린 본문을 이 줄 유무로 가린다).
# claude-layer-a-body-end v1
