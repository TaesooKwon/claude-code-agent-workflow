#!/usr/bin/env bash
# git pre-merge-commit(층 A) — git merge 가 만드는 병합 커밋을 디스패처(같은 디렉터리의 pre-commit)의 병합 모드로 넘긴다.
# 병합 모드에서 도는 게이트·그 이유는 디스패처 머리말이 정본이다.
exec bash "$(dirname "$0")/pre-commit" --merge
